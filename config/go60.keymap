  *                                  ┌───────┬──────┬──────┐  ┌──────┬──────┬──────┐
  *                                  │ Bksp  │      │      │  │      │      │ held │
  *                                  └───────┴──────┴──────┘  └──────┴──────┴──────┘
  */
 &trans     &none     &none     &none      &none  &none                                                       &none     &none     &none      &none  &none  &none
 &trans  &kp ESC     &none     &none      &none  &none                                                       &none     &none    &kp UP      &none  &none  &none
 &trans     &none  &kp LALT  &kp LGUI  &kp LSHFT  &none                                                   &kp LEFT  &kp DOWN    &kp UP  &kp RIGHT  &none  &none
 &trans     &none     &none     &none      &none  &none                                                       &none     &none     &none      &none  &none  &none
                      &trans    &trans     &trans                                                                        &trans    &trans     &trans
                                                        &kp BSPC  &trans  &trans  &trans  &trans  &trans
            >;
        };

        layer_symbols {
            bindings = <
 /*
  * SYMBOLS LAYER — hold LH_T3 to activate
  *
  * Left hand: programming symbols, paired brackets on same fingers
  *   Row 1: ` ( ) ; ,
  *   Row 2: ! { ' " } ?
  *   Row 3: # ^ = _ $ *
  *   Row 4: @ < | - > /
  *   Row 5: [ ] +
  *
  * Right hand: editing shortcuts on homerow
  *   Row 2: ; { " '
  *   Row 3: .  Bksp  Tab  Space  Enter  (edit without leaving layer)
