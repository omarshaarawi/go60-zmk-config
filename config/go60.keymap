/ {
    keymap {
        compatible = "zmk,keymap";


        layer_Base {
            bindings = <
 /*
  * BASE LAYER — 7 changes from Glove80 transfer
  *
  * ┌───────┬──────┬──────┬──────┬──────┬──────┐                              ┌──────┬──────┬──────┬──────┬──────┬──────────┐
  * │  = +  │  1 ! │  2 @ │  3 # │  4 $ │  5 % │                              │  6 ^ │  7 & │  8 * │  9 ( │  0 ) │ Hyp+K    │
  * ├───────┼──────┼──────┼──────┼──────┼──────┤                              ├──────┼──────┼──────┼──────┼──────┼──────────┤
  * │  Tab  │  Q   │  W   │  E   │  R   │  T   │                              │  Y   │  U   │  I   │  O   │  P   │  - _     │
  * ├───────┼──────┼──────┼──────┼──────┼──────┤                              ├──────┼──────┼──────┼──────┼──────┼──────────┤
  * │Ct/Esc │  A   │  S   │  D   │  F   │  G   │                              │  H   │  J   │  K   │  L   │  ; : │ Ct/'     │
  * ├───────┼──────┼──────┼──────┼──────┼──────┤                              ├──────┼──────┼──────┼──────┼──────┼──────────┤
  * │ Magic │  Z   │  X   │  C   │  V   │  B   │                              │  N   │  M   │  , < │  . > │  / ? │ Num tog  │
  * └───────┴──────┼──────┼──────┼──────┘──────┘                              └──────┴──────┼──────┼──────┼──────┴──────────┘
  *                │  -   │ Alt  │  `~  │                                             │  [   │  ]   │  \|  │
  *                └──────┴──────┴──────┘                                             └──────┴──────┴──────┘
  *
  *                                 ┌──────┬──────┬──────┐  ┌────────┬───────────┬──────────┐
  *                                 │ Bksp │ Cmd  │ Sym  │  │ Sticky │ Hyp/Enter │ Nav/Spc  │
  *                                 │      │      │ hold │  │ Shift  │  mod-tap   │ lt-tap   │
  *                                 └──────┴──────┴──────┘  └────────┴───────────┴──────────┘
  *
  * CHANGES FROM GLOVE80 TRANSFER:
  *   1. RH_T3: &mo symbols → &sk LSHFT (sticky shift, recovers lost Glove80 shift)
  *   2. LH_C3R5: ( → Left Alt
  *   3. LH_C2R5: ) → ` ~ (grave/tilde — vim marks, terminal)
  *   4. RH_C2R5: { → [ (vim motions)
  *   5. RH_C3R5: } → ] (vim motions)
  *   6. RH_C4R5: [ → \ | (moved from main block conflict)
  *   7. Nav layer LH_C5R2: none → Esc (easy escape while holding nav)
  */
       &kp EQUAL  &kp N1     &kp N2      &kp N3      &kp N4  &kp N5                                                                                                               &kp N6        &kp N7        &kp N8    &kp N9    &kp N0  &kp LG(LA(LS(LC(K))))
         &kp TAB   &kp Q      &kp W       &kp E       &kp R   &kp T                                                                                                                &kp Y         &kp U         &kp I     &kp O     &kp P              &kp MINUS
   &mt LCTRL ESC   &kp A      &kp S       &kp D       &kp F   &kp G                                                                                                                &kp H         &kp J         &kp K     &kp L  &kp SEMI          &mt RCTRL SQT
 &td_LAYER_Magic   &kp Z      &kp X       &kp C       &kp V   &kp B                                                                                                                &kp N         &kp M     &kp COMMA   &kp DOT  &kp FSLH        &tog LAYER_nums
                          &kp MINUS   &kp LALT    &kp GRAVE                                                                                                                                  &kp LBKT      &kp RBKT  &kp BSLH
                                                                     &kp BSPC  &kp LGUI  &mo LAYER_symbols  &sk LSHFT  &mt LG(LA(LS(LCTRL))) RET  &lt LAYER_nav SPACE
            >;
        };

        layer_nums {
            bindings = <
 /*
  * NUMS LAYER — toggle via RH pinky R4
  *
  * Left: F1-F12, homerow mods for modified number input
  * Right: clean numpad with operators
  *
  * ┌───────┬───────┬───────┬───────┬───────┬──────┐                        ┌──────┬──────┬──────┬──────┬──────┬──────┐
  * │       │  F1   │  F2   │  F3   │  F4   │  F5  │                        │  F6  │  F7  │  F8  │  F9  │ F10  │      │
  * ├───────┼───────┼───────┼───────┼───────┼──────┤                        ├──────┼──────┼──────┼──────┼──────┼──────┤
  * │       │  F11  │  F12  │       │       │      │                        │  *   │  7   │  8   │  9   │  +   │  =   │
  * ├───────┼───────┼───────┼───────┼───────┼──────┤                        ├──────┼──────┼──────┼──────┼──────┼──────┤
  * │       │ Ctrl  │ Alt   │ Cmd   │ Shift │      │                        │  :   │  4   │  5   │  6   │  -   │      │
  * ├───────┼───────┼───────┼───────┼───────┼──────┤                        ├──────┼──────┼──────┼──────┼──────┼──────┤
  * │       │       │       │       │       │      │                        │  .   │  1   │  2   │  3   │  ,   │ Base │
  * └───────┴───────┼───────┼───────┼───────┘──────┘                        └──────┴──────┼──────┼──────┼──────┴──────┘
  *                 │       │       │       │                                      │ Spc  │  ,   │  .   │
  *                 └───────┴───────┴───────┘                                      └──────┴──────┴──────┘
  *                                   ┌──────┬──────┬──────┐  ┌──────┬──────┬──────┐
  *                                   │      │      │      │  │      │      │  0   │
  *                                   └──────┴──────┴──────┘  └──────┴──────┴──────┘
  */
  &trans     &kp F1    &kp F2    &kp F3     &kp F4  &kp F5                                                          &kp F6     &kp F7      &kp F8      &kp F9        &kp F10  &trans
 &trans    &kp F11   &kp F12     &none      &none   &none                                                     &kp LS(N8)     &kp N7      &kp N8      &kp N9  &kp LS(EQUAL)  &kp EQUAL
 &trans  &kp LCTRL  &kp LALT  &kp LGUI  &kp LSHFT   &none                                                  &kp LS(SEMI)     &kp N4      &kp N5      &kp N6      &kp MINUS  &trans
 &trans      &none     &none     &none      &none   &none                                                       &kp DOT     &kp N1      &kp N2      &kp N3      &kp COMMA  &tog LAYER_nums
                       &trans    &trans     &trans                                                                        &kp SPACE   &kp COMMA     &kp DOT
                                                           &trans  &trans  &trans  &trans  &trans  &kp N0
            >;
        };

        layer_nav {
            bindings = <
 /*
  * NAV LAYER — hold Space (RH_T1) to activate
  *
  * Vim-optimized: HJKL arrows on homerow, left hand mods for
  * Shift+Arrow (select), Cmd+Arrow (jump), Alt+Arrow (word jump).
  * Esc on left hand Q position for easy cancel while holding nav.
  *
  * ┌───────┬──────┬──────┬──────┬───────┬──────┐                        ┌──────┬──────┬──────┬──────┬──────┬──────┐
  * │       │      │      │      │       │      │                        │      │      │      │      │      │      │
  * ├───────┼──────┼──────┼──────┼───────┼──────┤                        ├──────┼──────┼──────┼──────┼──────┼──────┤
  * │       │ Esc  │      │      │       │      │                        │      │      │  ↑   │      │      │      │
  * ├───────┼──────┼──────┼──────┼───────┼──────┤                        ├──────┼──────┼──────┼──────┼──────┼──────┤
  * │       │      │ Alt  │ Cmd  │ Shift │      │                        │  ←   │  ↓   │  ↑   │  →   │      │      │
  * ├───────┼──────┼──────┼──────┼───────┼──────┤                        ├──────┼──────┼──────┼──────┼──────┼──────┤
  * │       │      │      │      │       │      │                        │      │      │      │      │      │      │
  * └───────┴──────┼──────┼──────┼───────┘──────┘                        └──────┴──────┼──────┼──────┼──────┴──────┘
  *                │      │      │       │                                      │      │      │      │
