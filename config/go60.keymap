/* Generated input processors */
/ {
    input_processors {
        zip_click_to_right_click_mapper: zip_click_to_right_click_mapper {
            compatible = "zmk,input-processor-code-mapper";
            #input-processor-cells = <0>;
            type = <INPUT_EV_KEY>;
            map = <INPUT_BTN_0 INPUT_BTN_1>;
        };
    };
};

/* Custom Device-tree */
&mt {
    tapping-term-ms = <180>;
    flavor = "tap-preferred";
    retro-tap;
};

&sk {
    release-after-ms = <2000>;
    quick-release;
};

/* Input Listeners */
&cirque_lh_listener {
    input-processors = <&zip_xy_scaler 1 15>, <&zip_xy_transform INPUT_TRANSFORM_Y_INVERT>, <&zip_xy_to_scroll_mapper>;
};

&cirque_rh_listener {
    input-processors = <&zip_xy_scaler 6 2>;
};

/* System behavior and macros */
/ {
    behaviors {
        ZMK_TD_LAYER(lower, LAYER_Lower)
    };
};

/ {
    macros {
        rgb_ug_status_macro: rgb_ug_status_macro {
            label = "RGB_UG_STATUS";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&rgb_ug RGB_STATUS>;
        };

        /* Code digraph macros — fired by combos below */
        m_fat_arrow:  m_fat_arrow  { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp EQUAL &kp GT>; };
        m_thin_arrow: m_thin_arrow { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp MINUS &kp GT>; };
        m_dbl_colon:  m_dbl_colon  { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp COLON &kp COLON>; };
        m_neq:        m_neq        { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp EXCL  &kp EQUAL>; };
        m_eqeq:       m_eqeq       { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp EQUAL &kp EQUAL>; };
        m_and_and:    m_and_and    { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp AMPS  &kp AMPS>; };
        m_or_or:      m_or_or      { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp PIPE  &kp PIPE>; };
    };
};

/ {
    combos {
        compatible = "zmk,combos";
        /* Vertical combos on the base layer — least likely to misfire during normal typing */
        combo_fat_arrow  { timeout-ms = <30>; key-positions = <31 43>; bindings = <&m_fat_arrow>;  layers = <0>; }; /* J + M  -> => */
        combo_thin_arrow { timeout-ms = <30>; key-positions = <32 44>; bindings = <&m_thin_arrow>; layers = <0>; }; /* K + ,  -> -> */
        combo_dbl_colon  { timeout-ms = <30>; key-positions = <27 39>; bindings = <&m_dbl_colon>;  layers = <0>; }; /* D + C  -> :: */
        combo_neq        { timeout-ms = <30>; key-positions = <26 38>; bindings = <&m_neq>;        layers = <0>; }; /* S + X  -> != */
        combo_eqeq       { timeout-ms = <30>; key-positions = <25 37>; bindings = <&m_eqeq>;       layers = <0>; }; /* A + Z  -> == */
        combo_and_and    { timeout-ms = <30>; key-positions = <28 40>; bindings = <&m_and_and>;    layers = <0>; }; /* F + V  -> && */
        combo_or_or      { timeout-ms = <30>; key-positions = <29 41>; bindings = <&m_or_or>;      layers = <0>; }; /* G + B  -> || */
    };
};

/ {
#ifdef BT_DISC_CMD
    behaviors {
        bt_0: bt_0 {
            compatible = "zmk,behavior-tap-dance";
            label = "BT_0";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&bt_select_0>, <&bt BT_DISC 0>;
        };
        bt_1: bt_1 {
            compatible = "zmk,behavior-tap-dance";
            label = "BT_1";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&bt_select_1>, <&bt BT_DISC 1>;
        };
        bt_2: bt_2 {
            compatible = "zmk,behavior-tap-dance";
            label = "BT_2";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&bt_select_2>, <&bt BT_DISC 2>;
        };
        bt_3: bt_3 {
            compatible = "zmk,behavior-tap-dance";
            label = "BT_3";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&bt_select_3>, <&bt BT_DISC 3>;
        };
    };
    macros {
        bt_select_0: bt_select_0 {
            label = "BT_SELECT_0";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&out OUT_BLE>,
                  <&bt BT_SEL 0>;
        };
        bt_select_1: bt_select_1 {
            label = "BT_SELECT_1";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&out OUT_BLE>,
                  <&bt BT_SEL 1>;
        };
        bt_select_2: bt_select_2 {
            label = "BT_SELECT_2";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&out OUT_BLE>,
                  <&bt BT_SEL 2>;
        };
        bt_select_3: bt_select_3 {
            label = "BT_SELECT_3";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&out OUT_BLE>,
                  <&bt BT_SEL 3>;
        };
    };
#else
    macros {
        bt_0: bt_0 {
            label = "BT_0";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&out OUT_BLE>,
                  <&bt BT_SEL 0>;
        };
        bt_1: bt_1 {
            label = "BT_1";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&out OUT_BLE>,
                  <&bt BT_SEL 1>;
        };
        bt_2: bt_2 {
            label = "BT_2";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&out OUT_BLE>,
                  <&bt BT_SEL 2>;
        };
        bt_3: bt_3 {
            label = "BT_3";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&out OUT_BLE>,
                  <&bt BT_SEL 3>;
        };
    };
#endif
};

/ {
    behaviors {
        magic: magic {
            compatible = "zmk,behavior-hold-tap";
            label = "MAGIC_HOLD_TAP";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&mo>, <&rgb_ug_status_macro>;
        };

        /* Hold = mod (e.g. Hyper), tap = sticky key (e.g. one-shot Shift) */
        hyper_sk: hyper_sk {
            compatible = "zmk,behavior-hold-tap";
            label = "HYPER_STICKY";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&kp>, <&sk>;
        };
    };
};

/* Custom Defined Behaviors */
/ {
#define HYP(key) LS(LC(LA(LG(key))))
#define HYPER    LS(LC(LA(LGUI)))
#define MACLOCK  LG(LC(Q))
#define BROWSER_NEWTAB LG(T)
#define BROWSER_CLOSETAB LG(W)
#define BROWSER_NEXTTAB LG(LA(RIGHT))
#define BROWSER_PREVTAB LG(LA(LEFT))
};

/ {
    macros {

    };
};

/ {
    behaviors {

        ZMK_TD_LAYER(td_LAYER_Magic, 4)

        colon_semi: colon_semi {
            compatible = "zmk,behavior-mod-morph";
            label = "COLON_SEMI";
            #binding-cells = <0>;
            bindings = <&kp LS(SEMI)>, <&kp SEMI>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

    };
};

/* Automatically generated keymap */
/ {
    keymap {
        compatible = "zmk,keymap";


        layer_Base {
            bindings = <
 /*
  * ┌───────┬──────┬──────┬──────┬──────┬──────┐                              ┌──────┬──────┬──────┬──────┬──────┬──────────┐
  * │  = +  │  1 ! │  2 @ │  3 # │  4 $ │  5 % │                              │  6 ^ │  7 & │  8 * │  9 ( │  0 ) │ Hyp+K    │
  * ├───────┼──────┼──────┼──────┼──────┼──────┤                              ├──────┼──────┼──────┼──────┼──────┼──────────┤
  * │  Tab  │  Q   │  W   │  E   │  R   │  T   │                              │  Y   │  U   │  I   │  O   │  P   │  Alt     │
  * ├───────┼──────┼──────┼──────┼──────┼──────┤                              ├──────┼──────┼──────┼──────┼──────┼──────────┤
  * │Ct/Esc │  A   │  S   │  D   │  F   │  G   │                              │  H   │  J   │  K   │  L   │ : ;  │ Ct/'     │
  * ├───────┼──────┼──────┼──────┼──────┼──────┤                              ├──────┼──────┼──────┼──────┼──────┼──────────┤
  * │ Magic │  Z   │  X   │  C   │  V   │  B   │                              │  N   │  M   │  , < │  . > │  / ? │ Num tog  │
  * └───────┴──────┼──────┼──────┼──────┘──────┘                              └──────┴──────┼──────┼──────┼──────┴──────────┘
  *                │ - _  │  (   │  )   │                                             │  [   │  ]   │  \|  │
  *                └──────┴──────┴──────┘                                             └──────┴──────┴──────┘
  *
  *                              ┌──────┬──────┬────────┐  ┌──────┬───────────┬──────────┐
  *                              │ Bksp │ Cmd  │Sk Shft │  │ Sym  │ Sym/Enter │ Nav/Spc  │
  *                              └──────┴──────┴────────┘  └──────┴───────────┴──────────┘
  */
       &kp EQUAL  &kp N1     &kp N2      &kp N3      &kp N4  &kp N5                                                                                                               &kp N6        &kp N7        &kp N8    &kp N9    &kp N0  &kp LG(LA(LS(LC(K))))
         &kp TAB   &kp Q      &kp W       &kp E       &kp R   &kp T                                                                                                                &kp Y         &kp U         &kp I     &kp O     &kp P              &kp LALT
   &mt LCTRL ESC   &kp A      &kp S       &kp D       &kp F   &kp G                                                                                                                &kp H         &kp J         &kp K     &kp L  &colon_semi       &mt RCTRL SQT
 &td_LAYER_Magic   &kp Z      &kp X       &kp C       &kp V   &kp B                                                                                                                &kp N         &kp M     &kp COMMA   &kp DOT  &kp FSLH        &tog LAYER_nums
                          &kp MINUS   &kp LS(N9)  &kp LS(N0)                                                                                                                                &kp LBKT      &kp RBKT    &kp BSLH
                                                                      &kp BSPC  &kp LGUI  &sk LSHFT  &hyper_sk LG(LA(LS(LCTRL))) RSHIFT  &lt LAYER_symbols RET  &lt LAYER_nav SPACE
            >;
        };

        layer_nums {
            bindings = <
 /*
  * NUMS — toggle via RH pinky R4
  *
  * Left: F1-F12, homerow mods
  * Right: numpad with operators
  */
  &trans     &kp F1    &kp F2    &kp F3     &kp F4  &kp F5                                                          &kp F6     &kp F7      &kp F8      &kp F9        &kp F10  &trans
 &trans    &kp F11   &kp F12     &none      &none   &none                                                     &kp LS(N8)     &kp N7      &kp N8      &kp N9  &kp LS(EQUAL)  &kp EQUAL
 &trans  &kp LCTRL  &kp LALT  &kp LGUI  &kp LSHFT   &none                                                         &kp N0     &kp N4      &kp N5      &kp N6      &kp MINUS  &trans
 &trans      &none     &none     &none      &none   &none                                                       &kp DOT     &kp N1      &kp N2      &kp N3      &kp COMMA  &tog LAYER_nums
                       &trans    &trans     &trans                                                                        &kp SPACE   &kp COMMA     &kp DOT
                                                           &trans  &trans  &trans  &trans  &trans  &kp N0
            >;
        };

        layer_nav {
            bindings = <
 /*
  * NAV — hold Space to activate
  *
  * ┌──────┬──────┬──────┬──────┬──────┬──────┐    ┌──────┬──────┬──────┬──────┬──────┬──────┐
  * │      │      │      │      │      │      │    │      │      │      │      │      │      │
  * ├──────┼──────┼──────┼──────┼──────┼──────┤    ├──────┼──────┼──────┼──────┼──────┼──────┤
  * │      │      │      │      │      │      │    │ Home │ PgDn │ PgUp │ End  │      │      │
  * ├──────┼──────┼──────┼──────┼──────┼──────┤    ├──────┼──────┼──────┼──────┼──────┼──────┤
  * │      │ Ctrl │ Alt  │ Cmd  │ Shft │      │    │ Left │ Down │  Up  │Right │      │      │
  * ├──────┼──────┼──────┼──────┼──────┼──────┤    ├──────┼──────┼──────┼──────┼──────┼──────┤
  * │      │      │      │      │      │      │    │      │      │      │      │      │      │
  * └──────┴──────┴──────┴──────┴──────┴──────┘    └──────┴──────┴──────┴──────┴──────┴──────┘
  */
 &trans  &none      &none     &none      &none  &none                                                    &none      &none      &none    &none  &none  &none
 &trans  &none      &none     &none      &none  &none                                                 &kp HOME  &kp PG_DN  &kp PG_UP  &kp END  &none  &none
 &trans  &kp LCTRL  &kp LALT  &kp LGUI  &kp LSHFT  &none                                             &kp LEFT   &kp DOWN     &kp UP  &kp RIGHT  &none  &none
 &trans  &none      &none     &none      &none  &none                                                    &none      &none      &none    &none  &none  &none
                    &trans    &trans     &trans                                                                      &trans     &trans   &trans
                                                        &kp BSPC  &trans  &trans  &trans  &trans  &trans
            >;
        };

        layer_symbols {
            bindings = <
 /*
  * SYMBOLS — hold Enter (RH_T2) to activate.
  *
  * Left hand = symbols (Glove80 homerow: # ^ = _ $ *).
  * Right hand = editing cluster (bksp/del/tab on homerow).
  *
  * ┌──────┬──────┬──────┬──────┬──────┬──────┐    ┌──────┬──────┬──────┬──────┬──────┬──────┐
  * │      │  !   │  @   │  (   │  )   │  +   │    │  ^   │  &   │  *   │      │      │      │
  * ├──────┼──────┼──────┼──────┼──────┼──────┤    ├──────┼──────┼──────┼──────┼──────┼──────┤
  * │      │  \   │  {   │  }   │  |   │  `   │    │      │      │      │      │      │      │
  * ├──────┼──────┼──────┼──────┼──────┼──────┤    ├──────┼──────┼──────┼──────┼──────┼──────┤
  * │  #   │  ^   │  =   │  _   │  $   │  *   │    │  .   │ Bksp │ Tab  │ Spc  │ Ret  │      │
  * ├──────┼──────┼──────┼──────┼──────┼──────┤    ├──────┼──────┼──────┼──────┼──────┼──────┤
  * │      │  ~   │  [   │  ]   │  -   │  /   │    │  /   │ Del  │ STab │      │  ?   │      │
  * └──────┴──────┴──────┴──────┴──────┴──────┘    └──────┴──────┴──────┴──────┴──────┴──────┘
  */
 &trans      &kp EXCL   &kp AT     &kp LPAR   &kp RPAR    &kp PLUS                                                                               &kp CARET  &kp AMPS    &kp STAR    &none       &none      &trans
 &trans      &kp BSLH   &kp LBRC   &kp RBRC   &kp PIPE    &kp GRAVE                                                                              &none      &none       &none       &none       &none      &trans
 &kp HASH    &kp CARET  &kp EQUAL  &kp UNDER  &kp DLLR    &kp STAR                                                                               &kp DOT    &kp BSPC    &kp TAB    &kp SPACE   &kp RET    &none
 &trans      &kp TILDE  &kp LBKT   &kp RBKT   &kp MINUS   &kp FSLH                                                                               &kp FSLH   &kp DEL     &kp LS(TAB) &none      &kp QMARK  &trans
                            &trans     &trans     &trans                                                                                                        &trans      &trans      &trans
                                                                          &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        layer_Magic {
            bindings = <
  &bt BT_CLR     &kp C_BRI_DN     &kp C_BRI_UP       &kp C_PREV       &kp C_NEXT         &kp C_PP                                                  &kp C_MUTE  &kp C_VOL_DN  &kp C_VOL_UP   &none   &kp LG(LS(N4))   &kp LG(LC(Q))
 &bootloader  &rgb_ug RGB_SPI  &rgb_ug RGB_SAI  &rgb_ug RGB_HUI  &rgb_ug RGB_BRI  &rgb_ug RGB_TOG                                                       &none         &none         &none   &none   &none      &bootloader
